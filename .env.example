# Modele de configuration. Copier en .env et renseigner.
# Aucune valeur reelle ici : ce fichier est versionne.
#
# La liste de reference est le schema zod de src/lib/env.ts. Toute variable
# absente de ce schema n'est pas validee au demarrage : elle echoue au moment
# ou elle sert, pas avant.

# ---------------------------------------------------------------------------
# Socle
# ---------------------------------------------------------------------------

# development | test | production. Defaut : development.
# En conteneur, l'image la fixe deja a production.
NODE_ENV=development

POSTGRES_PORT=5432

# Chaine de connexion PostgreSQL. Correspond au service du docker-compose local.
# En production, la valeur vient de la base standalone Coolify (connexion interne).
DATABASE_URL=postgresql://account_manager:account_manager@localhost:${POSTGRES_PORT}/account_manager

# ---------------------------------------------------------------------------
# Authentification (NextAuth v5)
# ---------------------------------------------------------------------------

# Secret de signature des sessions. Generer avec : openssl rand -base64 32
# Le changer invalide toutes les sessions en cours.
AUTH_SECRET=

# URL publique de l'application, telle que vue par le navigateur.
# Sert a construire les liens de connexion envoyes par courriel.
AUTH_URL=http://localhost:3000

# Derriere le proxy Coolify (Traefik), NextAuth refuse par defaut de faire
# confiance a l'en-tete Host en production. A poser a true en deploiement.
# AUTH_TRUST_HOST=true

# Relais SMTP d'envoi des liens de connexion. URL de connexion nodemailer
# complete, avec les identifiants dedans :
#   smtp://utilisateur:motdepasse@serveur:port
#
# smtp:// negocie STARTTLS si le serveur l'annonce ; smtps:// exige TLS des la
# connexion et vise le port 465. Un mot de passe contenant @ : / doit etre encode
# en pourcentage, sans quoi l'URL se coupe au mauvais endroit.
#
# En local : mailpit, sans authentification ni TLS.
SMTP_URL=smtp://localhost:1025

# Adresse expeditrice des liens de connexion. Son domaine doit etre verifie
# chez le relais, faute de quoi l'envoi est refuse la-bas et non ici.
SMTP_EMAIL_FROM=comptes@example.org

# ---------------------------------------------------------------------------
# Espace membre beta.gouv
# ---------------------------------------------------------------------------

# Defaut : https://espace-membre.incubateur.net
ESPACE_MEMBRE_URL=https://espace-membre.incubateur.net

# Cle de l'API protegee de l'espace membre.
ESPACE_MEMBRE_API_KEY=

# ---------------------------------------------------------------------------
# Garde-fous
# ---------------------------------------------------------------------------

# Faux par defaut : toute execution est une simulation. Aucune ecriture n'est
# faite sur un systeme cible tant que cette variable ne vaut pas exactement
# "true". C'est l'interrupteur general, il ne se contourne pas par du code.
ACTIONS_ENABLED=false

# Usernames beta.gouv autorises a ouvrir l'outil et a executer un plan.
# Liste separee par des virgules. Vide = personne ne peut se connecter.
OPERATORS=

# Usernames de secours, autorises a se connecter hors de la liste des
# operateurs. Chaque connexion par ce chemin est journalisee comme telle.
BREAK_GLASS_USERNAMES=

# ---------------------------------------------------------------------------
# Politique
# ---------------------------------------------------------------------------

# Repertoire de accounts.yaml et config.yaml. Defaut : config.
# Seule variable lue hors du schema zod, et a dessein : celui-ci valide tout d'un
# bloc, or "pnpm policy:check" doit pouvoir verifier un YAML sans base ni secrets.
# En conteneur, l'image depose la politique au bon endroit, rien a poser ici.
# POLICY_DIR=config

# ---------------------------------------------------------------------------
# Comportement de l'image (conteneur uniquement)
# ---------------------------------------------------------------------------

# Le point d'entree applique "prisma migrate deploy" avant de demarrer le
# serveur. Passer a false pour reprendre la main sur une migration sensible :
# le conteneur demarre alors sur le schema en l'etat. Voir docs/deploiement.md.
# RUN_MIGRATIONS_ON_BOOT=true

# ---------------------------------------------------------------------------
# Credentials des connecteurs
#
# Le champ CredentialRef.source du contrat dit d'ou vient chaque credential :
# "env" pour ce qui est nativement cloisonnable, "fgp" pour ce qui passe par
# fine-grained-proxy parce que le fournisseur ne sait pas restreindre.
#
# Un credential absent ne bloque rien : le connecteur concerne se resout au tier
# "none", la collecte l'annonce et passe au suivant. Les emplacements encore
# commentes sont a confirmer quand leur connecteur arrivera.
# ---------------------------------------------------------------------------

# --- github --- source env, non nominatif. LU PAR LE CODE.
# Jeton fine-grained restreint a l'organisation incubateur-ademe, en lecture
# seule (read:org). Sans lui, la collecte GitHub est annoncee comme non lue.
GITHUB_TOKEN=

# --- notion:scim --- source env, NOMINATIF
# Jeton SCIM du workspace Notion. Porte "list" et "revoke" des membres : il sait
# retirer un membre et le deconnecter de toutes ses sessions, sans aucun systeme
# de portee. L'outil ne s'en sert qu'en lecture.
#
# Nominatif malgre les apparences : Notion le revoque au depart de la personne qui
# l'a cree, mais aussi a son simple changement de role, et n'importe quel
# proprietaire de workspace peut le retirer. Seul un proprietaire d'organisation
# peut en generer un, et il en faut un par workspace.
NOTION_SCIM_TOKEN=

# --- notion:session --- source env, NOMINATIF
# Jeton de session d'une personne physique, pour l'API Notion v3 non
# documentee (invites, trombinoscope). Dette explicite : il meurt avec le
# compte qui le porte et donne les droits de cette personne.
# NOTION_SESSION_TOKEN=
# NOTION_SESSION_SPACE_ID=

# --- ovh (email-list) --- source fgp, jamais en direct
# Le triplet OVH porte le compte entier sur /email/domain, il ne se cloisonne
# pas cote fournisseur. L'application ne detient pas le token upstream : elle
# appelle fine-grained-proxy, qui porte l'allowlist METHOD:PATH et journalise.
# FGP_BASE_URL=
# FGP_TOKEN=
