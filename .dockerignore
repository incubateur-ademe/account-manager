# Reinstalle depuis le lockfile dans l'image, jamais copie depuis l'hote
node_modules/
.pnpm-store/

# Rebuild dans l'image : la sortie locale porte les binaires de l'hote
.next/
out/
build/
dist/

# Regenere par "prisma generate" au prebuild
src/generated/

.git/
.github/
.claude/

.env
.env.*

# La politique n'entre dans l'image que par l'etape "politique", qui la tire de
# son propre depot. Sans cette exclusion, un build local embarquerait au passage
# les fichiers reels du poste de developpement, silencieusement.
config/*.yaml
!config/*.exemple.yaml

docs/
coverage/
*.tsbuildinfo
*.log
.DS_Store

Dockerfile
.dockerignore
docker-compose.yml
README.md
CLAUDE.md
