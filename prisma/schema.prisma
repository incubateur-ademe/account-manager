generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentification (NextAuth v5 + @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Exigés par @incubateur-ademe/next-auth-espace-membre-provider.
  username         String? @unique
  isBetaGouvMember Boolean @default(false)

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Périmètre
// ---------------------------------------------------------------------------

enum PersonSource {
  BETA
  LOCAL
  SERVICE
}

/// Voie par laquelle l'espace-membre rattache une personne à l'incubateur, et rien
/// d'autre : par startup, par équipe, par les deux, ou pas du tout. Ce champ
/// documente un fait constaté, on n'y mélange pas du décidé, d'où ScopeOverride.
enum Attachment {
  STARTUPS
  DECLARED
  BOTH
  NONE
}

model Person {
  id String @id @default(cuid())

  username String @unique

  /// Vrai quand l'identifiant a été construit ici, faute de fiche beta.gouv. C'est
  /// le seul cas où il se renomme : un vrai pivot ne se met à jour nulle part. La
  /// collecte l'éteint le jour où elle adopte la fiche.
  usernameFabricated Boolean @default(false)

  // Conserve a titre informatif, pour croiser avec une autre source le jour ou
  // ce sera utile. Ce n'est ni le pivot ni une cle de rapprochement : le username
  // est immuable cote espace-membre, et aucun endpoint ne resout un uuid.
  betaUuid String? @unique

  fullname           String
  primaryEmail       String?
  communicationEmail String?
  githubLogin        String?
  missionEnd         DateTime?    @db.Date
  source             PersonSource @default(BETA)
  attachment         Attachment   @default(NONE)
  startups           String[]     @default([])

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  vanishedAt  DateTime?

  /// Quand la collecte a revu une fiche qu'elle avait vue disparaitre. firstSeenAt ne
  /// bouge jamais, retour compris : jugee sur elle seule, une personne revenue
  /// resterait ineligible pour toujours, alors que son retour est une arrivee a
  /// traiter. C'est le seul signe d'un nouveau sejour, et il vient de la collecte :
  /// une mission qui s'acheve ne fait pas sortir du referentiel, donc rien du cote
  /// des dossiers ne dit qu'un sejour a recommence.
  returnedAt DateTime?

  identities         ExternalIdentity[]
  references         Reference[]
  accessCases        AccessCase[]
  findings           Finding[]
  startupAssignments StartupAssignment[]
  scopeOverride      ScopeOverride?

  @@index([missionEnd])
  @@index([vanishedAt])
}

/// Rattachement à une startup décidé par un opérateur, là où Person.startups ne
/// porte que ce que la collecte constate et se réécrit sans condition à chaque
/// passage. Il vit donc ici, où rien ne l'écrase.
model StartupAssignment {
  id String @id @default(cuid())

  personId String

  /// Identifiant et non clé étrangère, comme Person.startups : la startup peut
  /// disparaître de l'incubateur sans que la décision cesse d'avoir été prise.
  startupGhid String

  /// Dernier jour couvert, inclusif, au même titre qu'une fin de mission. Il n'y a
  /// pas de rattachement manuel sans date de fin : c'est ce qui borne le geste.
  until DateTime @db.Date

  reason String?

  createdBy String
  createdAt DateTime @default(now())

  /// Un retrait ferme, il ne supprime pas : une ligne effacée rendrait illisible un
  /// constat levé la veille.
  endedAt DateTime?
  endedBy String?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, endedAt])
  @@index([startupGhid, endedAt])
}

model ServiceAccount {
  id String @id @default(cuid())

  key           String @unique
  label         String
  purpose       String
  ownerUsername String

  reviewEveryDays Int       @default(180)
  lastReviewedAt  DateTime?

  identities ExternalIdentity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUsername])
  @@index([lastReviewedAt])
}

// ---------------------------------------------------------------------------
// Constaté
// ---------------------------------------------------------------------------

enum IdKind {
  OPAQUE
  EMAIL
  UPN
}

enum MatchMethod {
  DECLARED
  GITHUB_LOGIN
  EMAIL_EXACT
  HEURISTIC
  NONE
}

model ExternalIdentity {
  id String @id @default(cuid())

  provider   String
  externalId String
  idKind     IdKind @default(OPAQUE)
  handle     String

  // Nul signifie « compte isolé » : aucune identité du périmètre ne le réclame.
  // C'est un résultat du système, jamais une anomalie à corriger avant écriture.
  personId         String?
  serviceAccountId String?
  matchMethod      MatchMethod @default(NONE)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  vanishedAt  DateTime?

  /// Ce que le connecteur sait du compte et qu'aucune ressource ni aucun acces ne
  /// dit : type de compte, invitation en attente et son auteur. Une liste ordonnee
  /// de couples libelle et valeur, deja redigee pour etre lue par un humain, rendue
  /// telle quelle et jamais interpretee. Nulle quand il n'a rien a en dire.
  details Json?

  person         Person?         @relation(fields: [personId], references: [id], onDelete: SetNull)
  serviceAccount ServiceAccount? @relation(fields: [serviceAccountId], references: [id], onDelete: SetNull)

  grants   AccessGrant[]
  findings Finding[]

  @@unique([provider, externalId])
  @@index([personId])
  @@index([serviceAccountId])
  @@index([provider, vanishedAt])
}

model Resource {
  id String @id @default(cuid())

  provider   String
  externalId String
  label      String
  url        String?

  grants     AccessGrant[]
  references Reference[]

  @@unique([provider, externalId])
}

model AccessGrant {
  id String @id @default(cuid())

  externalIdentityId String
  resourceId         String
  role               String

  lastActivityAt DateTime?
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  vanishedAt     DateTime?

  externalIdentity ExternalIdentity @relation(fields: [externalIdentityId], references: [id], onDelete: Cascade)
  resource         Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([externalIdentityId, resourceId, role])
  @@index([vanishedAt])
  @@index([lastActivityAt])
}

enum OnOffboard {
  ARCHIVE
  TRANSFER
  KEEP
}

model Reference {
  id String @id @default(cuid())

  personId   String
  provider   String
  resourceId String
  onOffboard OnOffboard @default(ARCHIVE)

  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([personId, resourceId])
  @@index([provider])
}

model Startup {
  id String @id @default(cuid())

  ghid          String  @unique
  name          String
  incubatorGhid String
  currentPhase  String?

  phaseStart  DateTime? @db.Date
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  vanishedAt  DateTime?

  @@index([incubatorGhid])
  @@index([currentPhase])
}

enum SyncStatus {
  OK
  PARTIAL
  FAILED
  /// Systeme non lu, sans que ce soit un echec : credential absent, ou systeme
  /// entierement manuel. Distinct de FAILED, qui accuserait le systeme a tort,
  /// et surtout distinct de l'absence de trace, ou rien ne permet de dire si un
  /// systeme est sans ecart ou simplement jamais regarde.
  SKIPPED
}

model SyncRun {
  id String @id @default(cuid())

  provider   String
  capability String
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  status     SyncStatus
  itemsSeen  Int        @default(0)
  error      Json?

  @@index([provider, startedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Décidé
// ---------------------------------------------------------------------------

enum ScopeDecision {
  INCLUDE
  EXCLUDE
}

/// Ce qu'un opérateur décide de l'appartenance au périmètre, quand les faits ne
/// suffisent pas : quelqu'un rattaché à l'incubateur sans être sur une startup
/// précise, ou quelqu'un dont on veut dire qu'il n'est plus des nôtres.
///
/// Elle dit l'appartenance, elle n'ordonne rien : elle ne pose aucun vanishedAt,
/// n'ouvre ni ne ferme aucun constat, ne rend aucune identité révocable. Ce qui
/// coupe des accès reste le dossier de départ, avec son plan et sa confirmation.
///
/// L'historique n'est pas dupliqué ici : il vit dans le journal, et le retrait
/// supprime la ligne.
model ScopeOverride {
  id String @id @default(cuid())

  /// Une surcharge en cours au plus, portée par le schéma plutôt que par le code
  /// appelant.
  personId String        @unique
  decision ScopeDecision

  /// Obligatoire, comme la raison d'une clôture de constat : une décision
  /// d'appartenance sans motif est une décision qu'on ne saura pas réexaminer.
  reason String

  createdBy String
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

enum CaseKind {
  ONBOARDING
  OFFBOARDING
}

enum CaseState {
  WATCH
  CANDIDATE
  CONFIRMED
  CANCELLED
  DONE
}

model AccessCase {
  id String @id @default(cuid())

  personId String
  kind     CaseKind

  /// Sans defaut : les etats admis dependent du sens, une arrivee n'admet pas
  /// WATCH, et un defaut que la regle metier interdit finirait par etre pose par
  /// le premier create ecrit un peu vite.
  state CaseState

  /// Le profil que cette arrivee applique, tel qu'il est declare dans la politique.
  /// Il vit sur le dossier et pas sur le plan : c'est lui qui rend le recalcul
  /// reproductible, un plan recalcule sans savoir quel profil l'a produit ne
  /// retrouverait aucune de ses etapes d'octroi et se declarerait obsolete tout seul.
  ///
  /// Une cle et non une relation : les profils vivent dans le fichier de politique,
  /// pas en base. Un profil retire de la politique laisse donc une cle qui ne resout
  /// plus, et c'est le comportement voulu, le dossier disant ce qui a ete choisi ce
  /// jour-la plutot que ce qui existe aujourd'hui.
  ///
  /// Nulle pour un depart, qui n'applique aucun profil, et pour une arrivee ouverte
  /// avant que le choix n'existe.
  profileKey String?

  firstSignalAt   DateTime  @default(now())
  effectiveDate   DateTime? @db.Date
  cancelledReason String?

  /// Quand le dossier a ete clos. L'etat DONE dit que le sejour est fini, il ne dit
  /// pas quand : effectiveDate est une date de prise d'effet, saisie et souvent
  /// absente, et rien d'autre n'horodate la cloture.
  ///
  /// Elle ne decide d'aucune arrivee, et ne l'a jamais valablement fait : une mission
  /// qui s'acheve ne fait pas sortir du referentiel, si bien qu'un depart correctement
  /// solde laisse la fiche en place, et prendre cette cloture pour la fin d'un sejour
  /// levait un constat d'arrivee sur la personne qu'on venait d'offboarder. Un retour
  /// se lit sur Person.returnedAt, et sur rien d'autre. La colonne reste : dater la
  /// cloture d'un dossier est une donnee metier a part entiere, et l'historique des
  /// departs clos ne se reconstitue pas apres coup.
  closedAt DateTime?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  plans  Plan[]

  /// Un index unique partiel sur (personId, kind), limite aux etats vivants, vit en
  /// base sans figurer ici : Prisma ne sait pas exprimer la clause WHERE, et il ne
  /// voit pas non plus l'index comme une derive. Il est ecrit a la main dans la
  /// migration 20260824153852_un_seul_dossier_vivant. Sans cette ligne, la garde
  /// serait invisible a qui lit ce fichier.

  @@index([personId])
  @@index([state])
  @@index([kind, state])
}

enum PlanKind {
  ONBOARDING
  OFFBOARDING
  DRIFT_FIX
  MANUAL_OP
}

enum PlanState {
  DRAFT
  CONFIRMABLE
  EXECUTING
  EXECUTED
  PARTIALLY_EXECUTED
  CANCELLED
  EXPIRED
  STALE
}

model Plan {
  id String @id @default(cuid())

  accessCaseId String?
  kind         PlanKind
  state        PlanState @default(DRAFT)

  planDigest      String
  confirmedDigest String?

  createdBy   String
  confirmedBy String?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  accessCase AccessCase? @relation(fields: [accessCaseId], references: [id], onDelete: SetNull)
  steps      PlanStep[]

  @@index([state])
  @@index([accessCaseId])

  /// Un index unique partiel sur ("accessCaseId"), qui exclut les etats d'un plan
  /// ecarte (CANCELLED, EXPIRED, STALE), vit en base sans figurer ici : Prisma ne sait
  /// pas exprimer la clause WHERE, et il ne voit pas non plus l'index comme une
  /// derive. Il est ecrit a la main dans la migration
  /// 20260824161541_un_seul_plan_courant_par_dossier. Sans cette ligne, la garde
  /// serait invisible a qui lit ce fichier.
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum StepState {
  PENDING
  SKIPPED
  SUCCEEDED
  ALREADY_ABSENT
  ALREADY_PRESENT
  STALE
  FAILED
}

model PlanStep {
  id String @id @default(cuid())

  planId     String
  systemKey  String
  tier       String
  capability String
  action     String

  // Figé à la création : ce qui est confirmé doit rester lisible dans deux ans,
  // même si la ressource visée a changé de nom depuis.
  label String

  params        Json
  riskLevel     RiskLevel @default(MEDIUM)
  expectedState Json

  /// Rang de lecture, fige dans la ligne au meme titre que le libelle. L'ordre
  /// d'execution est un autre ordre, calcule au demarrage et jamais reecrit ici.
  ordre Int @default(0)

  // La marche a suivre telle qu'elle etait au moment ou le plan a ete calcule :
  // titre, runbook, lien direct, et ce qu'il faut constater pour cocher. Figee ici
  // au meme titre que le reste de l'etape, parce qu'un runbook reformule ne doit pas
  // changer ce qui a ete approuve. Nulle pour une etape automatique.
  manual Json?

  /// L'origine declaree de l'etape, gelee au meme titre que le reste : quel modele
  /// l'a demandee, sous quelle cle, et quelle saisie elle attendait ce jour-la.
  /// Forme { owner, stepKey, saisie? }. Nulle signifie « vient d'un connecteur ».
  template Json?

  /// Ce que l'operateur a saisi au pointage, quand l'etape declaree attendait une
  /// valeur. Une saisie obligatoire refuse le pointage tant que cette colonne est
  /// vide, sur le modele du refus de note.
  reponse String?

  /// L'echeance decidee d'un octroi. Elle vit ici et pas sur AccessGrant : cette
  /// table est reconstruite par la collecte, une echeance decidee y serait effacee a
  /// la premiere nuit.
  grantExpiresAt DateTime?

  /// Pourquoi cet acces a ete accorde, quand il ne vient d'aucun profil. Jamais
  /// remplie automatiquement depuis un profil : le profil est la justification, et la
  /// recopier ferait naitre la file des acces a justifier deja pleine de faux.
  justification String?

  state     StepState @default(PENDING)
  attempts  Int       @default(0)
  lastError String?

  executedAt      DateTime?
  reversibleUntil DateTime?
  idempotencyKey  String    @unique

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([state])
  @@index([grantExpiresAt])
}

/// Le moment qu'un modele sert. Enum propre et non PlanKind : un modele n'a rien a
/// dire d'un DRIFT_FIX ni d'un MANUAL_OP, et la conversion se fait par une fonction
/// pure qui rend null pour ces deux-la.
enum TemplateKind {
  ONBOARDING
  OFFBOARDING
}

model PlanTemplate {
  id String @id @default(cuid())

  /// ghid de la startup proprietaire, ou la constante reservee "*incubateur".
  /// Chaine non nullable : dans PostgreSQL deux NULL ne s'egalent pas, et une
  /// colonne nullable laisserait creer plusieurs modeles d'incubateur pour un meme
  /// moment. Le caractere * est impossible dans un ghid beta.gouv, la collision est
  /// donc exclue par construction. Pas de cle etrangere vers Startup : Person.startups
  /// porte deja des ghid sans FK, et l'assemblage compare des ghid a des ghid. Un ghid
  /// devenu orphelin se signale a l'ecran, c'est le seul endroit ou un renommage amont
  /// se verra.
  ownerKey String
  kind     TemplateKind

  /// N'a de sens que sur le modele de l'incubateur. Ferme par defaut : un plan
  /// assemble ne gagne pas une etape que personne n'a admise. Refermer neutralise les
  /// etapes de startup sans rien supprimer, rouvrir rend tout a l'identique.
  startupsMayExtend Boolean @default(false)

  steps PlanTemplateStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerKey, kind])
}

model PlanTemplateStep {
  id String @id @default(cuid())

  templateId String

  /// Titre slugifie, calcule a l'ecriture. C'est la cle de deduplication entre
  /// modeles : deux startups qui declarent le meme geste ne le font faire qu'une fois.
  key      String
  position Int

  title    String
  runbook  String?
  deeplink String?

  /// Ce qu'il faut constater pour cocher. Obligatoire : sans lui, « fait » ne veut
  /// rien dire.
  doneWhen String

  /// Saisie attendue au pointage, validee par saisieAttendueSchema. Nulle quand
  /// l'etape ne demande qu'une case.
  input Json?

  riskLevel RiskLevel @default(LOW)

  template PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, key])
  @@index([templateId, position])
}

enum FindingKind {
  SCOPE_EXIT
  SCOPE_ENTRY
  INACTIVE_STARTUP
  ORPHAN
  UNREGISTERED
  UNMATCHED_IDENTITY
  EXPIRED_GRANT
  DORMANT
  PRIVILEGE_DRIFT
  UNVERIFIABLE
  OVERDUE_MANUAL_ACTION
}

model Finding {
  id String @id @default(cuid())

  kind               FindingKind
  personId           String?
  externalIdentityId String?
  severity           RiskLevel   @default(MEDIUM)

  dedupKey String @unique

  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  closeReason String?

  /// Opérateur qui a clos le constat. Tant qu'il est renseigné, la collecte ne
  /// rouvre pas le constat : un humain a jugé la situation traitée, et la lui
  /// resservir chaque nuit reviendrait à ignorer son jugement. Le verrou se lève
  /// dès que la situation cesse d'être constatée, pour qu'un nouvel épisode soit
  /// bien signalé. Qui a clos quoi, et pourquoi, vit dans le journal.
  closedBy String?

  person           Person?           @relation(fields: [personId], references: [id], onDelete: Cascade)
  externalIdentity ExternalIdentity? @relation(fields: [externalIdentityId], references: [id], onDelete: Cascade)

  @@index([kind, closedAt])
  @@index([personId])
}

model Derogation {
  id String @id @default(cuid())

  targetType String
  targetId   String
  reason     String

  createdBy String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([targetType, targetId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Journal
// ---------------------------------------------------------------------------

enum ActorKind {
  HUMAN
  SYSTEM
}

model AuditEvent {
  id String @id @default(cuid())

  at            DateTime  @default(now())
  actorKind     ActorKind
  actorUsername String?
  action        String
  targetType    String
  targetId      String?
  correlationId String?
  before        Json?
  after         Json?
  result        String

  @@index([at])
  @@index([targetType, targetId])
  @@index([correlationId])
  @@index([actorUsername])
}

/// Autorisation ponctuelle de dater les disparitions d'un fournisseur malgré le
/// garde-fou de chute.
///
/// Le garde-fou refuse de conclure quand une collecte perd une part excessive de ce
/// qu'elle connaissait, et il a raison de le faire. Mais quand la chute vient de
/// données que ce refus empêche justement de nettoyer, il se maintient tout seul :
/// rien n'en sort, et aucune disparition n'est plus jamais datée pour ce système.
/// Cette table est la sortie, et elle est nominative : l'outil constate, un opérateur
/// décide, le journal garde qui a décidé quoi.
model ScopeDropOverride {
  id String @id @default(cuid())

  provider String

  /// « identites » ou « ressources » : les deux verrous sont distincts, une
  /// autorisation ne lève que le sien.
  famille String

  /// Obligatoire, comme la raison d'une surcharge d'appartenance : lever un garde-fou
  /// sans motif est une décision qu'on ne saura pas réexaminer.
  reason String

  createdBy String
  createdAt DateTime @default(now())

  /// Se consomme au premier passage qui s'en sert, et ne vaut donc que pour lui : une
  /// autorisation qui durerait éteindrait le garde-fou au lieu de le lever une fois.
  consumedAt    DateTime?
  consumedRunId String?

  @@index([provider, famille, consumedAt])
}
